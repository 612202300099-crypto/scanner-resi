# Supabase Configuration
# Copy this file to .env.local and fill in your values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Desty Omni API — frontend must NOT contain Desty secrets
VITE_DESTY_API_URL=https://api.desty.app
VITE_DESTY_WEBHOOK_URL=

# Server-only env for Vercel API route /api/sync-desty
# Set these in Vercel Project Settings → Environment Variables, never expose them with VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
DESTY_ACCESS_TOKEN=
DESTY_TENANT_ID=165686
